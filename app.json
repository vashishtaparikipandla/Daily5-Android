{
  "expo": {
    "name": "Daily 5",
    "slug": "daily5-android",
    "version": "1.0.0",
    "owner": "vashishtaparikipandla",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "daily5-android",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F4EF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.daily5.android"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#F7F4EF"
      },
      "package": "app.daily5.android",
      "versionCode": 3,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Daily 5 needs access to your photos to attach them to diary entries.",
          "cameraPermission": "Daily 5 needs access to your camera to take photos for diary entries."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Daily 5 uses Face ID so you can unlock your diary quickly."
        }
      ],
      "expo-updates",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "origin": "https://replit.com/"
      },
      "eas": {
        "projectId": "552303a5-a73e-4163-bc69-27ffb2b55c53"
      }
    }
  }
}
